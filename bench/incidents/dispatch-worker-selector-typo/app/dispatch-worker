#!/bin/sh
# image: harbor.larkspur.internal/notify/dispatch-worker:6.0.1
tpl="http://notify-templates:8080"
for a in "$@"; do case "$a" in --templates=*) tpl="${a#--templates=}" ;; esac; done
echo "dispatch-worker 6.0.1: queue=outbound templates=$tpl"
for i in 1 2 3; do
  echo "loading template order-shipped from $tpl/v2/templates/order-shipped (attempt $i/3)"
  if out=$(wget -q -T 3 -O /dev/null "$tpl/v2/templates/order-shipped" 2>&1); then echo "templates loaded"; exec sleep 86400; fi
  echo "$out"
  sleep 2
done
echo "FATAL: template service unavailable, cannot render notifications"
exit 1
