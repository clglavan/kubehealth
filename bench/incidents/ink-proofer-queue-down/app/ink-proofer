#!/bin/sh
# image: harbor.quillmoss.internal/ops/ink-proofer:1.3.1
q="ink-queue:5672"
for a in "$@"; do case "$a" in --queue=*) q="${a#--queue=}" ;; esac; done
echo "ink-proofer 1.3.1: consuming proof jobs from $q"
for i in 1 2 3; do
  if nc -z -w 3 "${q%:*}" "${q##*:}" 2>/dev/null; then echo "connected"; exec sleep 86400; fi
  echo "amqp $q: $(telnet "${q%:*}" "${q##*:}" </dev/null 2>&1 | head -1) (attempt $i/3)"
  sleep 2
done
echo "Error: proof queue $q unavailable, giving up"
exit 1
